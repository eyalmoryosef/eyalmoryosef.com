# Admin panel — https://eyalmoryosef.com/admin
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=your-secure-password
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-long-random-string

# Production saves (Vercel) — commit via GitHub API
# Create token: GitHub → Settings → Developer settings → Personal access tokens
# Scopes: repo (Contents read/write)
GITHUB_TOKEN=
GITHUB_REPO=eyalmoryosef/eyalmoryosef.com
GITHUB_BRANCH=master
