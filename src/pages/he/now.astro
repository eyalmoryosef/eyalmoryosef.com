---
import PageLayout from "@layouts/PageLayout.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import NowBody from "@components/pages/NowBody.astro";
import { t } from "@/i18n/utils";
import { websiteJsonLd } from "@/lib/seo";
import { getNowContent } from "@/lib/page-content";

const locale = "he";
const now = getNowContent(locale);
---

<PageLayout
  title={t(locale, "now.title")}
  description={now.metaDescription}
  locale={locale}
  jsonLd={websiteJsonLd()}
  narrow={true}
>
  <SectionHeading title={t(locale, "now.title")} as="h1" />
  <NowBody locale={locale} />
</PageLayout>
