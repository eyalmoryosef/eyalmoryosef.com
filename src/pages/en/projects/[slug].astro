---
import PageLayout from "@layouts/PageLayout.astro";
import StatusBadge from "@components/projects/StatusBadge.astro";
import TechBadge from "@components/projects/TechBadge.astro";
import { getCollection, render } from "astro:content";
import { parseContentId } from "@/lib/utils";
import { websiteJsonLd } from "@/lib/seo";
import { SITE } from "@/lib/constants";

const locale = "en";

export async function getStaticPaths() {
  const projects = await getCollection("projects", (entry) => {
    const { locale: l } = parseContentId(entry.id);
    return l === "en";
  });

  return projects.map((project) => {
    const { slug } = parseContentId(project.id);
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { Content } = await render(project);
const { slug } = parseContentId(project.id);
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  locale={locale}
  jsonLd={websiteJsonLd()}
  canonicalUrl={`${SITE.url}/${locale}/projects/${slug}/`}
  narrow={true}
>
  <article>
    <header class="mb-8">
      <div class="flex items-start justify-between mb-4">
        <h1>{project.data.title}</h1>
        <StatusBadge status={project.data.status} locale={locale} />
      </div>
      <p class="text-text-secondary text-lg mb-4">{project.data.description}</p>
      <div class="flex flex-wrap gap-2 mb-6">
        {project.data.techStack.map((tech: string) => (
          <TechBadge label={tech} />
        ))}
      </div>
      {project.data.externalUrl && (
        <a
          href={project.data.externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-600 hover:text-brand-800 text-sm font-medium"
        >
          View Project &rarr;
        </a>
      )}
    </header>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</PageLayout>
