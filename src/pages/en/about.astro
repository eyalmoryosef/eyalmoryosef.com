---
import PageLayout from "@layouts/PageLayout.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import SkillsGrid from "@components/about/SkillsGrid.astro";
import ContactForm from "@components/about/ContactForm.astro";
import AboutBody from "@components/pages/AboutBody.astro";
import { t } from "@/i18n/utils";
import { websiteJsonLd } from "@/lib/seo";
import { getAboutContent } from "@/lib/page-content";

const locale = "en";
const about = getAboutContent(locale);
---

<PageLayout
  title={t(locale, "about.title")}
  description={about.metaDescription}
  locale={locale}
  jsonLd={websiteJsonLd()}
>
  <SectionHeading title={t(locale, "about.title")} as="h1" />
  <AboutBody locale={locale} />
  <SkillsGrid locale={locale} />
  <ContactForm locale={locale} />
</PageLayout>
