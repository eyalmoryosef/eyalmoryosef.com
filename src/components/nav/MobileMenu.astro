---
import type { Locale } from "@/lib/types";
import { getNavItems } from "@/i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const navItems = getNavItems(locale);
---

<div id="mobile-menu" class="hidden fixed inset-0 z-50" style="background: var(--color-surface); color: var(--color-text-primary);">
  <div class="flex items-center justify-between px-4 py-4" style="border-bottom: 1px solid var(--color-border);">
    <span class="font-bold text-lg">
      <span class="gradient-text">eyal</span><span style="color: var(--color-accent);">/</span><span style="color: var(--color-text-secondary);">moryosef</span>
    </span>
    <button
      id="close-menu-btn"
      class="p-2 transition-colors"
      style="color: var(--color-text-secondary);"
      aria-label="Close menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col gap-2 p-6">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          "block py-3 px-4 rounded-lg text-lg transition-all",
          currentPath === item.href || (item.href !== `/${locale}/` && currentPath.startsWith(item.href))
            ? "glass-card font-semibold"
            : "",
        ]}
        style={
          currentPath === item.href || (item.href !== `/${locale}/` && currentPath.startsWith(item.href))
            ? "color: var(--color-accent);"
            : "color: var(--color-text-secondary);"
        }
      >
        {item.label}
      </a>
    ))}
    <div class="mt-4 pt-4" style="border-top: 1px solid var(--color-border);">
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
    </div>
  </nav>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const menu = document.getElementById('mobile-menu');
    const openBtn = document.getElementById('open-menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');

    if (openBtn && menu) {
      openBtn.addEventListener('click', () => {
        menu.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });
    }

    if (closeBtn && menu) {
      closeBtn.addEventListener('click', () => {
        menu.classList.add('hidden');
        document.body.style.overflow = '';
      });
    }
  });
</script>
