---
import type { Locale } from "@/lib/types";
import { getNavItems } from "@/i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileMenu from "./MobileMenu.astro";
import ThemeToggle from "@components/effects/ThemeToggle.astro";
import Container from "@components/ui/Container.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const navItems = getNavItems(locale);
---

<header class="sticky top-0 z-40 navbar-glass">
  <Container>
    <nav class="flex items-center justify-between h-16" aria-label="Main navigation">
      <!-- Skip to content -->
      <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:start-2 bg-brand-600 text-white px-4 py-2 rounded z-50">
        Skip to content
      </a>

      <!-- Logo / Name -->
      <a href={`/${locale}/`} class="font-bold text-lg transition-colors" style="color: var(--color-text-primary);">
        <span class="gradient-text">eyal</span><span style="color: var(--color-accent);">/</span><span style="color: var(--color-text-secondary);">moryosef</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium transition-colors",
              currentPath === item.href || (item.href !== `/${locale}/` && currentPath.startsWith(item.href))
                ? "accent-underline"
                : "",
            ]}
            style={
              currentPath === item.href || (item.href !== `/${locale}/` && currentPath.startsWith(item.href))
                ? "color: var(--color-accent);"
                : "color: var(--color-text-secondary);"
            }
          >
            {item.label}
          </a>
        ))}
        <LanguageSwitcher locale={locale} currentPath={currentPath} />
        <ThemeToggle />
      </div>

      <!-- Mobile: theme toggle + hamburger -->
      <div class="flex md:hidden items-center gap-2">
        <ThemeToggle />
        <button
          id="open-menu-btn"
          class="p-2 transition-colors"
          style="color: var(--color-text-secondary);"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </Container>
</header>

<MobileMenu locale={locale} currentPath={currentPath} />
