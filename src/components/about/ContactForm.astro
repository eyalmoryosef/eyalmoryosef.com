---
import type { Locale } from "@/lib/types";
import { SITE } from "@/lib/constants";
import { t } from "@/i18n/utils";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Button from "@components/ui/Button.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sent = Astro.url.searchParams.get("sent") === "true";
---

<section class="py-8">
  <SectionHeading
    title={t(locale, "about.contact")}
    subtitle={t(locale, "about.contactDescription")}
  />

  {sent && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm">
      {t(locale, "about.form.success")}
    </div>
  )}

  <form
    action={`https://formspree.io/f/${SITE.formspreeId}`}
    method="POST"
    class="max-w-lg space-y-4"
    id="contact-form"
  >
    <!-- Honeypot -->
    <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="_next" value={`${SITE.url}/${locale}/about/?sent=true`} />

    <div>
      <label for="name" class="block text-sm font-medium text-text-primary mb-1">
        {t(locale, "about.form.name")}
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-2.5 rounded-lg border border-border bg-white text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-text-primary mb-1">
        {t(locale, "about.form.email")}
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-2.5 rounded-lg border border-border bg-white text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-text-primary mb-1">
        {t(locale, "about.form.message")}
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full px-4 py-2.5 rounded-lg border border-border bg-white text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition resize-y"
      ></textarea>
    </div>

    <Button type="submit" variant="primary">
      {t(locale, "about.form.send")}
    </Button>
  </form>
</section>
