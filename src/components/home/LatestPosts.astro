---
import type { Locale } from "@/lib/types";
import type { CollectionEntry } from "astro:content";
import { t } from "@/i18n/utils";
import { parseContentId, getReadingTime } from "@/lib/utils";
import SectionHeading from "@components/ui/SectionHeading.astro";
import PostCard from "@components/blog/PostCard.astro";

interface Props {
  locale: Locale;
  posts: CollectionEntry<"blog">[];
}

const { locale, posts } = Astro.props;
---

<section class="py-12">
  <SectionHeading title={t(locale, "home.latest.title")} />
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => {
      const { slug } = parseContentId(post.id);
      return (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          readingTime={post.body ? getReadingTime(post.body) : 5}
          excerpt={post.data.description}
          href={`/${locale}/blog/${slug}/`}
          locale={locale}
        />
      );
    })}
  </div>
</section>
