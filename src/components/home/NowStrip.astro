---
import type { Locale } from "@/lib/types";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
  text: string;
}

const { locale, text } = Astro.props;
---

<section class="py-6 my-8 bg-surface-alt rounded-lg px-6">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-4">
    <span class="font-semibold text-text-primary">{t(locale, "home.now.prefix")}</span>
    <span class="text-text-secondary">{text}</span>
    <a
      href={`/${locale}/now/`}
      class="text-brand-600 hover:text-brand-800 text-sm font-medium transition-colors ms-auto"
    >
      {t(locale, "home.now.link")} &rarr;
    </a>
  </div>
</section>
